# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.turbo

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/

# next.js
/.next/
/out/

# TypeScript
*.tsbuildinfo

# production
/build
/public/sw.js

# misc
.DS_Store
*.pem
.cursor/scratchpad.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# tldr
.tldr

.eslintcache

# Windows crash dumps
*.exe.stackdump

.env*.local

.npmrc

*storybook.log
storybook-static
certificates

next-env.d.ts
# Python bytecode from the vendored ui-ux-pro-max skill's search scripts.
# The workflow in docs/ROADMAP.md runs those every stage, so this reappears
# constantly; the skill's own .py sources are committed, the cache is not.
__pycache__/
*.pyc

# claude
# Local agent state stays out of version control, but vendored skills are
# committed on purpose: any agent that opens this repo inherits them with
# no install step. Provenance and licence: docs/PROVENANCE.md section 3.
.claude/*
!.claude/skills/
.claude/settings.local.json
plans

# audit reports — generated by `/audit`, kept local, never committed
docs/audits/

# react-doctor — ignore generated diagnostics, keep the curated suppression list
.react-doctor/*
!.react-doctor/false-positives.md

# prepare-handoff backup — created by `bun run handoff` when swapping README
README.original.md

# setup:project --skip-install → prepare.ts handoff (P-B2) — see
# PENDING_FORMAT_MARKER in lib/scripts/utils.ts; deleted by prepare.ts on the
# next `bun install`, but ignore it in case that never runs.
.setup-project-pending-format.json

# setup:project concurrency lock (P-B3) — removed on exit, but ignore it in
# case a crash left it behind.
.setup-project.lock
